# Monorepo 分支自动化部署 Workflow
# 支持分支命名: {environment}-{domain}-{app-name}
# 示例: develop-backend-first-app, staging-frontend-web-app, prod-backend-second-app

name: Deploy Monorepo by Branch Name

on:
  push:
    branches:
      - 'develop-backend-*'
      - 'staging-backend-*'
      - 'prod-backend-*'
      - 'develop-frontend-*'
      - 'staging-frontend-*'
      - 'prod-frontend-*'
  pull_request:
    branches:
      - 'develop-backend-*'
      - 'staging-backend-*'
      - 'prod-backend-*'
      - 'develop-frontend-*'
      - 'staging-frontend-*'
      - 'prod-frontend-*'
  workflow_dispatch:

env:
  REGISTRY: ${{ vars.REGISTRY || 'localhost:5000' }}

jobs:
  # 解析分支信息
  parse-branch:
    runs-on: self-hosted
    outputs:
      environment: ${{ steps.parse.outputs.environment }}
      domain: ${{ steps.parse.outputs.domain }}
      app-name: ${{ steps.parse.outputs.app-name }}
      app-dir: ${{ steps.parse.outputs.app-dir }}
      dockerfile: ${{ steps.parse.outputs.dockerfile }}
      service-name: ${{ steps.parse.outputs.service-name }}
      port: ${{ steps.parse.outputs.port }}
      namespace: ${{ steps.parse.outputs.namespace }}
      image-name: ${{ steps.parse.outputs.image-name }}
      image-tag: ${{ steps.parse.outputs.image-tag }}
      log-level: ${{ steps.parse.outputs.log-level }}
      replicas: ${{ steps.parse.outputs.replicas }}
      commit-short: ${{ steps.parse.outputs.commit-short }}
      should-deploy: ${{ steps.check.outputs.should-deploy }}
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: 调试环境信息
        run: |
          echo "🐛 调试信息开始"
          echo "当前工作目录: $(pwd)"
          echo "用户: $(whoami)"
          echo "环境变量:"
          env | grep GITHUB | head -10
          echo ""
          echo "目录结构:"
          ls -la
          echo ""
          echo "scripts 目录:"
          ls -la scripts/ || echo "❌ scripts 目录不存在"
          echo ""
          echo "分支名称: ${{ github.ref_name }}"
          echo "🐛 调试信息结束"

      - name: 解析分支信息
        id: parse
        run: |
          BRANCH="${{ github.ref_name }}"
          echo "🔍 解析分支: $BRANCH"

          # 检查脚本文件
          echo "📋 检查脚本文件:"
          if [ -f "./scripts/parse-branch.sh" ]; then
            echo "✅ 脚本文件存在"
            echo "文件权限: $(ls -la ./scripts/parse-branch.sh)"
            echo "文件大小: $(wc -l ./scripts/parse-branch.sh)"
          else
            echo "❌ 脚本文件不存在"
            echo "当前目录内容:"
            find . -name "*.sh" -type f
            exit 1
          fi

          # 执行分支解析脚本
          echo "🚀 执行解析脚本..."
          ./scripts/parse-branch.sh "$BRANCH" > /tmp/branch-output.txt 2>&1
          SCRIPT_EXIT_CODE=$?

          echo "📋 脚本执行结果:"
          echo "退出代码: $SCRIPT_EXIT_CODE"
          echo "输出文件大小: $(wc -c /tmp/branch-output.txt)"
          echo ""

          # 显示完整输出
          echo "📄 脚本完整输出:"
          cat /tmp/branch-output.txt
          echo ""

          # 显示输出文件的每一行详细信息
          echo "🔍 输出文件逐行分析:"
          line_num=1
          while IFS= read -r line; do
            echo "第${line_num}行: '$line'"
            line_num=$((line_num + 1))
          done < /tmp/branch-output.txt
          echo ""

          # 提取关键信息 - 添加详细调试
          echo "🧪 开始提取变量..."

          # 使用新的提取方法
          echo "方法1: 使用 awk 提取"
          ENVIRONMENT=$(grep "环境:" /tmp/branch-output.txt | awk '{print $2}' || echo "NOT_FOUND")
          DOMAIN=$(grep "域:" /tmp/branch-output.txt | awk '{print $2}' || echo "NOT_FOUND")
          APP_NAME=$(grep "应用名:" /tmp/branch-output.txt | awk '{print $2}' || echo "NOT_FOUND")
          APP_DIR=$(grep "应用目录:" /tmp/branch-output.txt | awk '{print $2}' || echo "NOT_FOUND")
          DOCKERFILE=$(grep "Dockerfile:" /tmp/branch-output.txt | awk '{print $2}' || echo "NOT_FOUND")
          SERVICE_NAME=$(grep "服务名:" /tmp/branch-output.txt | awk '{print $2}' || echo "NOT_FOUND")
          PORT=$(grep "端口:" /tmp/branch-output.txt | awk '{print $2}' || echo "NOT_FOUND")
          NAMESPACE=$(grep "Namespace:" /tmp/branch-output.txt | awk '{print $2}' || echo "NOT_FOUND")
          IMAGE_NAME=$(grep "镜像名称:" /tmp/branch-output.txt | awk '{print $2}' || echo "NOT_FOUND")
          IMAGE_TAG=$(grep "镜像标签:" /tmp/branch-output.txt | awk '{print $2}' || echo "NOT_FOUND")
          LOG_LEVEL=$(grep "日志级别:" /tmp/branch-output.txt | awk '{print $2}' || echo "NOT_FOUND")
          REPLICAS=$(grep "副本数:" /tmp/branch-output.txt | awk '{print $2}' || echo "NOT_FOUND")
          COMMIT_SHORT=$(grep "Commit:" /tmp/branch-output.txt | awk '{print $2}' || echo "NOT_FOUND")

          echo "提取结果:"
          echo "  ENVIRONMENT: '$ENVIRONMENT'"
          echo "  DOMAIN: '$DOMAIN'"
          echo "  APP_NAME: '$APP_NAME'"
          echo "  APP_DIR: '$APP_DIR'"
          echo "  DOCKERFILE: '$DOCKERFILE'"
          echo "  SERVICE_NAME: '$SERVICE_NAME'"
          echo "  PORT: '$PORT'"
          echo "  NAMESPACE: '$NAMESPACE'"
          echo "  IMAGE_NAME: '$IMAGE_NAME'"
          echo "  IMAGE_TAG: '$IMAGE_TAG'"
          echo "  LOG_LEVEL: '$LOG_LEVEL'"
          echo "  REPLICAS: '$REPLICAS'"
          echo "  COMMIT_SHORT: '$COMMIT_SHORT'"
          echo ""

          # 验证目录存在性
          if [ "$APP_DIR" != "NOT_FOUND" ] && [ -n "$APP_DIR" ]; then
            echo "📂 验证应用目录: $APP_DIR"
            if [ -d "$APP_DIR" ]; then
              echo "✅ 应用目录存在"
              echo "目录内容:"
              ls -la "$APP_DIR"
            else
              echo "❌ 应用目录不存在"
              echo "当前目录下的 backend/app:"
              ls -la backend/app/ 2>/dev/null || echo "backend/app 目录不存在"
            fi
          else
            echo "❌ APP_DIR 提取失败"
          fi

          # 设置输出变量
          echo "📤 设置输出变量..."
          echo "environment=$ENVIRONMENT" >> $GITHUB_OUTPUT
          echo "domain=$DOMAIN" >> $GITHUB_OUTPUT
          echo "app-name=$APP_NAME" >> $GITHUB_OUTPUT
          echo "app-dir=$APP_DIR" >> $GITHUB_OUTPUT
          echo "dockerfile=$DOCKERFILE" >> $GITHUB_OUTPUT
          echo "service-name=$SERVICE_NAME" >> $GITHUB_OUTPUT
          echo "port=$PORT" >> $GITHUB_OUTPUT
          echo "namespace=$NAMESPACE" >> $GITHUB_OUTPUT
          echo "image-name=$IMAGE_NAME" >> $GITHUB_OUTPUT
          echo "image-tag=$IMAGE_TAG" >> $GITHUB_OUTPUT
          echo "log-level=$LOG_LEVEL" >> $GITHUB_OUTPUT
          echo "replicas=$REPLICAS" >> $GITHUB_OUTPUT
          echo "commit-short=$COMMIT_SHORT" >> $GITHUB_OUTPUT
          echo "✅ 变量设置完成"

      - name: 检查文件变更
        id: check
        run: |
          echo "🔍 检查文件变更步骤"

          # 获取前面步骤的输出
          APP_DIR="${{ steps.parse.outputs.app-dir }}"
          DOMAIN="${{ steps.parse.outputs.domain }}"
          APP_NAME="${{ steps.parse.outputs.app-name }}"
          ENVIRONMENT="${{ steps.parse.outputs.environment }}"

          echo "📋 接收到的变量:"
          echo "  APP_DIR: '$APP_DIR'"
          echo "  DOMAIN: '$DOMAIN'"
          echo "  APP_NAME: '$APP_NAME'"
          echo "  ENVIRONMENT: '$ENVIRONMENT'"
          echo ""

          # 详细的条件检查
          echo "🧪 执行条件检查..."

          # 检查 APP_DIR 是否为空
          if [ -z "$APP_DIR" ]; then
            echo "❌ APP_DIR 为空"
            echo "should-deploy=false" >> $GITHUB_OUTPUT
            echo "🚫 部署被跳过: APP_DIR 为空"
            exit 0
          fi

          # 检查 APP_DIR 是否等于 NOT_FOUND
          if [ "$APP_DIR" = "NOT_FOUND" ]; then
            echo "❌ APP_DIR 提取失败 (NOT_FOUND)"
            echo "should-deploy=false" >> $GITHUB_OUTPUT
            echo "🚫 部署被跳过: APP_DIR 提取失败"
            exit 0
          fi

          # 检查目录是否存在
          if [ ! -d "$APP_DIR" ]; then
            echo "❌ 应用目录不存在: $APP_DIR"
            echo "📂 当前目录结构:"
            find . -name "*app*" -type d | head -10
            echo ""
            echo "backend 目录:"
            ls -la backend/ 2>/dev/null || echo "backend 目录不存在"
            echo ""
            echo "backend/app 目录:"
            ls -la backend/app/ 2>/dev/null || echo "backend/app 目录不存在"
            echo "should-deploy=false" >> $GITHUB_OUTPUT
            echo "🚫 部署被跳过: 应用目录不存在"
            exit 0
          fi

          # 所有检查通过
          echo "✅ 所有检查通过"
          echo "✅ 找到应用目录: $APP_DIR"
          echo "📂 应用目录内容:"
          ls -la "$APP_DIR"
          echo ""
          echo "should-deploy=true" >> $GITHUB_OUTPUT
          echo "🚀 准备部署"

  # 构建 Docker 镜像
  build:
    needs: parse-branch
    if: needs.parse-branch.outputs.should-deploy == 'true'
    runs-on: self-hosted
    outputs:
      image-tag: ${{ steps.build.outputs.image-tag }}
      build-success: ${{ steps.build.outputs.build-success }}
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: 构建 Docker 镜像
        id: build
        run: |
          DOMAIN="${{ needs.parse-branch.outputs.domain }}"
          APP_NAME="${{ needs.parse-branch.outputs.app-name }}"
          ENVIRONMENT="${{ needs.parse-branch.outputs.environment }}"
          COMMIT_SHORT="${{ needs.parse-branch.outputs.commit-short }}"
          REGISTRY="${{ env.REGISTRY }}"
          IMAGE_NAME="${{ needs.parse-branch.outputs.image-name }}"
          IMAGE_TAG="${{ needs.parse-branch.outputs.image-tag }}"

          echo "🐳 构建镜像: $APP_NAME"
          echo "环境: $ENVIRONMENT"
          echo "镜像名称: $IMAGE_NAME"
          echo "镜像标签: $IMAGE_TAG"
          echo "Registry: $REGISTRY"

          # 使用新的统一构建系统为所有应用构建 Docker 镜像
          DOCKERFILE="deploy/docker/${APP_NAME}/Dockerfile"

          # 检查 Dockerfile 是否存在
          if [ ! -f "$DOCKERFILE" ]; then
            echo "❌ Dockerfile 不存在: $DOCKERFILE"
            echo "build-success=false" >> $GITHUB_OUTPUT
            exit 1
          fi

          # 构建镜像（支持配置注入）
          FULL_IMAGE_TAG="${REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG}"
          LATEST_TAG="${REGISTRY}/${IMAGE_NAME}:latest-${ENVIRONMENT}"

          echo "🔨 开始构建: $FULL_IMAGE_TAG"
          echo "📁 Dockerfile: $DOCKERFILE"
          echo "⚙️  环境: $ENVIRONMENT"
          echo "🏷️  应用: $APP_NAME"

          # 使用新的构建脚本（如果存在）或直接使用docker命令
          if [ -f "./scripts/build-docker.sh" ]; then
            echo "🛠️ 使用统一构建脚本..."
            ./scripts/build-docker.sh "$APP_NAME" "$ENVIRONMENT" --tag "$IMAGE_TAG"

            # 验证构建结果 - 最终修复：验证实际构建的镜像
            echo "🔍 验证构建结果..."
            echo "应用名: $APP_NAME"
            echo "环境: $ENVIRONMENT"
            echo "标签: $IMAGE_TAG"
            echo "构建脚本生成的镜像:"
            docker images | grep "$APP_NAME" || echo "未找到 $APP_NAME 镜像"

            # 验证两种标签：commit标签 和 latest-environment标签
            COMMIT_TAG="${APP_NAME}:${IMAGE_TAG}"
            LATEST_TAG="${APP_NAME}:latest-${ENVIRONMENT}"

            echo "验证标签1: $COMMIT_TAG"
            echo "验证标签2: $LATEST_TAG"

            if docker images | grep -q "$APP_NAME.*$IMAGE_TAG" && docker images | grep -q "$APP_NAME.*latest-${ENVIRONMENT}"; then
              echo "image-tag=$FULL_IMAGE_TAG" >> $GITHUB_OUTPUT
              echo "build-success=true" >> $GITHUB_OUTPUT
              echo "✅ 构建验证成功 - 两个标签都存在"
            else
              echo "❌ 构建验证失败 - 标签缺失"
              echo "image-tag=build-failed" >> $GITHUB_OUTPUT
              echo "build-success=false" >> $GITHUB_OUTPUT
              echo "🔍 详细调试:"
              docker images | grep "$APP_NAME" || echo "没有找到 $APP_NAME 相关镜像"
              echo "检查标签: $IMAGE_TAG (期望在镜像中存在)"
              echo "检查标签: latest-$ENVIRONMENT (期望在镜像中存在)"
            fi
          else
            echo "🐳 直接使用 Docker 命令构建..."
            docker build \
              --build-arg CONFIG_ENV="$ENVIRONMENT" \
              -f "$DOCKERFILE" \
              -t "$FULL_IMAGE_TAG" \
              -t "$LATEST_TAG" \
              .

            # 验证构建结果
            if [ $? -eq 0 ]; then
              echo "image-tag=$FULL_IMAGE_TAG" >> $GITHUB_OUTPUT
              echo "build-success=true" >> $GITHUB_OUTPUT
              echo "✅ 镜像构建完成"
              docker images | grep "$IMAGE_NAME"
            else
              echo "image-tag=build-failed" >> $GITHUB_OUTPUT
              echo "build-success=false" >> $GITHUB_OUTPUT
            fi
          fi

  # 部署到 Kubernetes
  deploy:
    needs: [parse-branch, build]
    if: |
      needs.parse-branch.outputs.should-deploy == 'true' &&
      needs.build.outputs.build-success == 'true' &&
      github.event_name == 'push'
    runs-on: self-hosted
    outputs:
      deployment-success: ${{ steps.deploy.outputs.deployment-success }}
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: 部署到 Kubernetes
        id: deploy
        env:
          KUBE_CONFIG_DATA: ${{ secrets.KUBE_CONFIG_DATA }}
        run: |
          DOMAIN="${{ needs.parse-branch.outputs.domain }}"
          APP_NAME="${{ needs.parse-branch.outputs.app-name }}"
          ENVIRONMENT="${{ needs.parse-branch.outputs.environment }}"
          NAMESPACE="${{ needs.parse-branch.outputs.namespace }}"
          IMAGE_TAG="${{ needs.parse-branch.outputs.image-tag }}"
          REGISTRY="${{ env.REGISTRY }}"
          LOG_LEVEL="${{ needs.parse-branch.outputs.log-level }}"
          REPLICAS="${{ needs.parse-branch.outputs.replicas }}"
          PORT="${{ needs.parse-branch.outputs.port }}"

          echo "🚀 部署应用: $APP_NAME"
          echo "域: $DOMAIN"
          echo "环境: $ENVIRONMENT"
          echo "命名空间: $NAMESPACE"
          echo "镜像标签: $IMAGE_TAG"

          # ⚡ 极简KUBECONFIG配置 - Pod内直连
          echo "⚡ 配置Kubernetes环境 - Pod内直连优化"

          # 创建最小化KUBECONFIG（Pod内通信最优）
          mkdir -p ~/.kube
          cat > ~/.kube/config << 'EOF'
apiVersion: v1
clusters:
- cluster:
    certificate-authority: /run/secrets/kubernetes.io/serviceaccount/ca.crt
    server: https://kubernetes.default.svc.cluster.local
  name: cluster
contexts:
- context:
    cluster: cluster
    user: user
  name: default
current-context: default
users:
- name: user
  user:
    tokenFile: /run/secrets/kubernetes.io/serviceaccount/token
EOF

          export KUBECONFIG="$HOME/.kube/config"
          export PATH="/opt/kubectl:$PATH"

          # 快速验证
          echo "⚡ KUBECONFIG: $KUBECONFIG"
          if kubectl cluster-info --request-timeout=10s; then
            echo "✅ Pod内Kubernetes连接成功"
          else
            echo "❌ Kubernetes连接失败"
            exit 1
          fi
          if [[ -n "$KUBE_CONFIG_DATA" ]]; then
            echo "🔧 使用GitHub Actions Secrets中的KUBECONFIG..."
            mkdir -p ~/.kube
            echo "$KUBECONFIG_DATA" | base64 -d > ~/.kube/config
            export KUBECONFIG="$HOME/.kube/config"
            echo "✅ GitHub Actions Secrets KUBECONFIG设置完成"
          # 优先级2: 使用in-cluster配置（推荐方案）
          elif [[ -f "/run/secrets/kubernetes.io/serviceaccount/ca.crt" ]] && [[ -f "/run/secrets/kubernetes.io/serviceaccount/token" ]]; then
            echo "🔧 使用in-cluster配置（推荐方案）..."
            # 创建in-cluster kubeconfig
            mkdir -p ~/.kube
            cat > ~/.kube/config << 'EOF'
apiVersion: v1
clusters:
- cluster:
    certificate-authority: /run/secrets/kubernetes.io/serviceaccount/ca.crt
    server: https://kubernetes.default.svc
  name: in-cluster
contexts:
- context:
    cluster: in-cluster
    user: in-cluster-user
  name: in-cluster
current-context: in-cluster
kind: Config
preferences: {}
users:
- name: in-cluster-user
  user:
    tokenFile: /run/secrets/kubernetes.io/serviceaccount/token
EOF
            export KUBECONFIG="$HOME/.kube/config"
            echo "✅ in-cluster KUBECONFIG设置完成"
          # 优先级3: 使用本地kubeconfig文件
          else
            echo "🔧 尝试使用本地kubeconfig文件..."
            # 尝试多种方式设置KUBECONFIG
            CURRENT_USER=$(whoami)
            echo "🔍 当前用户: $CURRENT_USER"

            # 方法1: 直接设置已知路径
            if [[ -f "/home/zeng/.kube/config" ]]; then
              export KUBECONFIG="/home/zeng/.kube/config"
              echo "✅ 方法1成功: 设置KUBECONFIG=$KUBECONFIG"
            # 方法2: 当前用户home目录
            elif [[ -f "$HOME/.kube/config" ]]; then
              export KUBECONFIG="$HOME/.kube/config"
              echo "✅ 方法2成功: 设置KUBECONFIG=$KUBECONFIG"
            # 方法3: root用户目录
            elif [[ -f "/root/.kube/config" ]]; then
              export KUBECONFIG="/root/.kube/config"
              echo "✅ 方法3成功: 设置KUBECONFIG=$KUBECONFIG"
            else
              echo "❌ 所有kubeconfig方法都失败了"
              echo "🔍 调试信息:"
              echo "  HOME: $HOME"
              echo "  当前用户: $(whoami)"
              echo "  in-cluster配置检查:"
              echo "    ca.crt: $([ -f "/run/secrets/kubernetes.io/serviceaccount/ca.crt" ] && echo '存在' || echo '不存在')"
              echo "    token: $([ -f "/run/secrets/kubernetes.io/serviceaccount/token" ] && echo '存在' || echo '不存在')"
              exit 1
            fi
          fi

          # 验证KUBECONFIG设置结果
          echo "🔍 验证KUBECONFIG设置结果..."
          echo "KUBECONFIG: ${KUBECONFIG:-'未设置'}"

          if [[ -n "$KUBECONFIG" ]] && [[ -f "$KUBECONFIG" ]]; then
            echo "✅ kubeconfig文件存在，大小: $(wc -c < "$KUBECONFIG") bytes"

            # 验证服务器地址和上下文
            if command -v kubectl &> /dev/null; then
              SERVER_URL=$(kubectl config view --minify=true | grep -o 'server:[^[:space:]]*' | cut -d':' -f2-)
              CURRENT_CONTEXT=$(kubectl config current-context 2>/dev/null || echo "in-cluster")
            else
              # 手动解析kubeconfig文件
              SERVER_URL=$(grep "server:" "$KUBECONFIG" | awk '{print $2}')
              CURRENT_CONTEXT="in-cluster"
            fi

            echo "🌐 服务器地址: $SERVER_URL"
            echo "🎯 当前上下文: $CURRENT_CONTEXT"
            echo "✅ KUBECONFIG配置验证完成"
          else
            echo "❌ KUBECONFIG配置失败"
            exit 1
          fi

          # 检查并安装kubectl
          if ! command -v kubectl &> /dev/null; then
            echo "📦 kubectl 未安装，正在安装..."
            curl -LO "https://dl.k8s.io/release/$(curl -L -s https://dl.k8s.io/release/stable.txt)/bin/linux/amd64/kubectl"
            chmod +x kubectl
            sudo mv kubectl /usr/local/bin/
            echo "✅ kubectl 安装完成"
          else
            echo "✅ kubectl 已安装: $(kubectl version --client --short 2>/dev/null || echo '版本未知')"
          fi

          # 验证 K8s 集群连接
          echo "🔍 验证集群连接..."
          if ! kubectl cluster-info --request-timeout=30s; then
            echo "❌ 无法连接到 Kubernetes 集群"
            echo "🔍 集群诊断信息:"
            echo "  当前用户: $(whoami)"
            echo "  KUBECONFIG: ${KUBECONFIG:-'未设置'}"
            echo "  尝试列出集群:"
            kubectl config get-contexts || echo "无法获取contexts"
            echo "deployment-success=false" >> $GITHUB_OUTPUT
            exit 1
          fi
          echo "✅ 集群连接验证通过"

          # 创建 namespace（如果不存在）
          echo "🏷️ 创建 namespace: $NAMESPACE"
          kubectl create namespace "$NAMESPACE" --dry-run=client -o yaml | kubectl apply -f -

          # 选择对应的 K8s 配置文件
          K8S_CONFIG="deploy/k8s/${DOMAIN}-${APP_NAME}.yaml"
          if [ ! -f "$K8S_CONFIG" ]; then
            echo "❌ K8s 配置文件不存在: $K8S_CONFIG"
            echo "📂 可用的K8s配置文件:"
            ls -la deploy/k8s/ || echo "deploy/k8s/ 目录不存在"
            echo "deployment-success=false" >> $GITHUB_OUTPUT
            exit 1
          fi

          echo "📝 使用配置文件: $K8S_CONFIG"

          # 准备环境变量替换
          FULL_IMAGE_NAME="${REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG}"

          # 设置默认的敏感数据值（生产环境需要替换为实际值）
          DB_PASSWORD="$(echo -n 'default-password' | base64)"
          API_KEY="$(echo -n 'default-api-key' | base64)"
          SESSION_SECRET="$(echo -n 'default-session-secret' | base64)"

          # 根据环境设置 API 基础 URL
          case "$ENVIRONMENT" in
            "develop")
              API_BASE_URL="http://backend-${APP_NAME}-service.app-${NAMESPACE}.svc.cluster.local"
              ;;
            "staging")
              API_BASE_URL="https://staging-api.example.com"
              ;;
            "prod")
              API_BASE_URL="https://api.example.com"
              ;;
            *)
              API_BASE_URL="http://localhost:8080"
              ;;
          esac

          # 使用 envsubst 替换配置文件中的变量
          echo "🔄 替换配置文件变量..."
          envsubst < "$K8S_CONFIG" > "/tmp/${APP_NAME}-config.yaml"

          # 验证替换后的配置文件
          echo "📋 验证配置文件..."
          if ! kubectl apply --dry-run=client -f "/tmp/${APP_NAME}-config.yaml"; then
            echo "❌ 配置文件验证失败"
            echo "deployment-success=false" >> $GITHUB_OUTPUT
            exit 1
          fi

          # 部署应用
          echo "☸️ 部署应用到 $NAMESPACE namespace..."
          kubectl apply -f "/tmp/${APP_NAME}-config.yaml"

          # 等待部署完成
          echo "⏳ 等待部署完成..."
          DEPLOYMENT_NAME="${DOMAIN}-${APP_NAME}"
          echo "🎯 等待部署: $DEPLOYMENT_NAME"

          if kubectl rollout status deployment/"$DEPLOYMENT_NAME" --namespace="$NAMESPACE" --timeout=120s; then
            echo "✅ 部署成功完成"
            echo "deployment-success=true" >> $GITHUB_OUTPUT

            # 显示部署状态
            echo "📊 部署状态:"
            kubectl get pods -n "$NAMESPACE" -l "app=${DOMAIN}-${APP_NAME}" -l "environment=${ENVIRONMENT}"
            kubectl get services -n "$NAMESPACE" -l "app=${DOMAIN}-${APP_NAME}" -l "environment=${ENVIRONMENT}"
          else
            echo "❌ 部署失败"
            echo "deployment-success=false" >> $GITHUB_OUTPUT

            # 显示失败的 pod 状态
            echo "🔍 失败的 pod 状态:"
            kubectl get pods -n "$NAMESPACE" -l "app=${DOMAIN}-${APP_NAME}" -l "environment=${ENVIRONMENT}"
            kubectl describe pods -n "$NAMESPACE" -l "app=${DOMAIN}-${APP_NAME}" -l "environment=${ENVIRONMENT}" | tail -20
            exit 1
          fi

          # 清理临时文件
          rm -f "/tmp/${APP_NAME}-config.yaml"

  # 验证部署
  verify:
    needs: [parse-branch, deploy]
    if: |
      needs.parse-branch.outputs.should-deploy == 'true' &&
      needs.deploy.outputs.deployment-success == 'true'
    runs-on: self-hosted
    steps:
      - name: 验证部署状态
        run: |
          DOMAIN="${{ needs.parse-branch.outputs.domain }}"
          APP_NAME="${{ needs.parse-branch.outputs.app-name }}"
          ENVIRONMENT="${{ needs.parse-branch.outputs.environment }}"
          NAMESPACE="${{ needs.parse-branch.outputs.namespace }}"
          PORT="${{ needs.parse-branch.outputs.port }}"

          echo "📊 验证部署状态..."

          # 检查 Pod 状态
          echo "🏷️ Pod 状态:"
          kubectl get pods --namespace="$NAMESPACE" -l "app=${DOMAIN}-${APP_NAME}" -l "environment=${ENVIRONMENT}"

          # 检查服务状态
          echo "🔌 服务状态:"
          kubectl get services --namespace="$NAMESPACE" -l "app=${DOMAIN}-${APP_NAME}" -l "environment=${ENVIRONMENT}"

          # 等待服务启动
          echo "⏳ 等待服务启动..."
          sleep 10

          # 端口转发以进行本地健康检查
          echo "🔄 设置端口转发..."
          DEPLOYMENT_NAME="${DOMAIN}-${APP_NAME}"
          SERVICE_NAME="${DOMAIN}-${APP_NAME}-service"

          # 在后台启动端口转发
          kubectl port-forward -n "$NAMESPACE" "service/${SERVICE_NAME}" 8080:80 &
          PORT_FORWARD_PID=$!

          # 等待端口转发生效
          sleep 5

          # 健康检查
          echo "🧪 执行健康检查..."

          # 根据应用类型进行不同的健康检查
          if [ "$DOMAIN" = "backend" ]; then
            # 后端应用检查
            if curl -f "http://localhost:8080/ping" 2>/dev/null; then
              echo "✅ 后端健康检查通过"
            else
              echo "⚠️ 后端健康检查失败，但部署可能仍在进行中"
            fi
          else
            # 前端应用检查
            if curl -f "http://localhost:8080/health" 2>/dev/null; then
              echo "✅ 前端健康检查通过"
            else
              echo "⚠️ 前端健康检查失败，但部署可能仍在进行中"
            fi
          fi

          # 清理端口转发
          kill $PORT_FORWARD_PID 2>/dev/null || true

          echo "✅ 验证完成"

  # 通知结果
  notify:
    needs: [parse-branch, build, deploy, verify]
    if: always()
    runs-on: self-hosted
    steps:
      - name: 部署结果通知
        run: |
          DOMAIN="${{ needs.parse-branch.outputs.domain }}"
          APP_NAME="${{ needs.parse-branch.outputs.app-name }}"
          ENVIRONMENT="${{ needs.parse-branch.outputs.environment }}"
          NAMESPACE="${{ needs.parse-branch.outputs.namespace }}"
          BRANCH="${{ github.ref_name }}"
          COMMIT="${{ github.sha }}"

          echo "📋 部署结果报告:"
          echo "===================="
          echo "🔗 分支: $BRANCH"
          echo "🏷️ 域: $DOMAIN"
          echo "📦 应用: $APP_NAME"
          echo "🌍 环境: $ENVIRONMENT"
          echo "🏷️ Namespace: $NAMESPACE"
          echo "🔖 Commit: $COMMIT"
          echo ""

          if [[ "${{ needs.deploy.result }}" == "success" ]]; then
            echo "🎉 部署成功!"
            echo "🌐 访问地址: http://localhost:8080 (通过端口转发)"
            echo "📊 K8s 命令查看状态:"
            echo "  kubectl get pods -n $NAMESPACE -l app=${DOMAIN}-${APP_NAME}"
            echo "  kubectl get services -n $NAMESPACE -l app=${DOMAIN}-${APP_NAME}"
            echo "🔄 端口转发命令:"
            echo "  kubectl port-forward -n $NAMESPACE service/${DOMAIN}-${APP_NAME}-service 8080:80"
          elif [[ "${{ needs.build.result }}" == "failure" ]]; then
            echo "❌ 构建失败!"
          elif [[ "${{ needs.deploy.result }}" == "failure" ]]; then
            echo "❌ 部署失败!"
            echo "🔍 故障排除:"
            echo "  kubectl get pods -n $NAMESPACE -l app=${DOMAIN}-${APP_NAME}"
            echo "  kubectl describe pods -n $NAMESPACE -l app=${DOMAIN}-${APP_NAME}"
            echo "🔄 回滚命令:"
            echo "  ./scripts/rollback.sh ${DOMAIN}-${APP_NAME} $ENVIRONMENT"
          elif [[ "${{ needs.parse-branch.outputs.should-deploy }}" == "false" ]]; then
            echo "ℹ️ 跳过部署 - 应用目录不存在或无变更。"
          else
            echo "⚠️ 未知状态"
          fi

          echo ""
          echo "🔧 维护命令:"
          echo "查看日志: kubectl logs -n $NAMESPACE -l app=${DOMAIN}-${APP_NAME} --tail=50"
          echo "查看事件: kubectl get events -n $NAMESPACE --sort-by=.metadata.creationTimestamp"